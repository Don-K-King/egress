# Copy this file to deploy/local/egress.config.yaml and replace all placeholder values.
# This config is intended for local development only.

log_level: debug
api_key: your-livekit-api-key
api_secret: your-livekit-api-secret

# Use the LiveKit endpoint from the shared livekit-net docker network.
ws_url: ws://livekit:7880
insecure: true

redis:
  # Reuse Redis from the LiveKit stack. Do not run a second Redis for Egress.
  address: redis:6379

# Optional local limits to avoid runaway jobs
# session_limits:
#   file_output_max_duration: 1h

# Optional hardening (requires security_opt seccomp profile in compose)
# enable_chrome_sandbox: true
